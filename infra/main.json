                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7
              }
            },
            {
              "type": "Microsoft.MachineLearningServices/workspaces",
              "apiVersion": "2024-04-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "friendlyName": "[parameters('name')]",
                "description": "AI Hub for ZavaStorefront - GPT-4 and Phi models",
                "storageAccount": "[resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', parameters('name')), '-', ''))]",
                "keyVault": "[resourceId('Microsoft.KeyVault/vaults', replace(format('{0}-kv', parameters('name')), '-', ''))]",
                "applicationInsights": "[parameters('appInsightsId')]",
                "containerRegistry": "[parameters('containerRegistryId')]",
                "publicNetworkAccess": "Enabled"
              },
              "kind": "Hub",
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', replace(format('{0}-kv', parameters('name')), '-', ''))]",
                "[resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', parameters('name')), '-', ''))]"
              ]
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the AI Hub"
              },
              "value": "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "metadata": {
                "description": "Name of the AI Hub"
              },
              "value": "[parameters('name')]"
            },
            "storageAccountId": {
              "type": "string",
              "metadata": {
                "description": "Storage account ID"
              },
              "value": "[resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', parameters('name')), '-', ''))]"
            },
            "keyVaultId": {
              "type": "string",
              "metadata": {
                "description": "Key Vault ID"
              },
              "value": "[resourceId('Microsoft.KeyVault/vaults', replace(format('{0}-kv', parameters('name')), '-', ''))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'acr')]",
        "[resourceId('Microsoft.Resources/deployments', 'appInsights')]"
      ]
    }
  ],
  "outputs": {
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry login server"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'acr'), '2025-04-01').outputs.loginServer.value]"
